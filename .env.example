# Copy to .env.sit, .env.uat, and .env.prod and fill in values (never commit those files).
# NODE_ENV selects which file is loaded: SIT → .env.sit, UAT → .env.uat, otherwise .env.prod

# Base URL of the target application
# .env.sit  → https://sit.anytimefitness.com
# .env.uat  → https://uat.anytimefitness.com
# .env.prod → https://anytimefitness.com
BASE_URL=https://sit.anytimefitness.com

# BrowserStack credentials (replace with your actual credentials)
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
WEBFLOW_API_TOKEN=
CURSOR_API_KEY=

# Geolocation setting (e.g., US-CA, US-WA, US-CT)
GEO_LOCATION=US-CA

DECODO_USERNAME=

DECODO_PASSWORD=

DECODO_API_KEY=

DECODO_PROXY_HOST=gate.decodo.com

DECODO_PROXY_PORT=7000

FIGMA_ACCESS_TOKEN=

FIGMA_FILE_URL=

GURU_USER_EMAIL=

GURU_USER_TOKEN=

GURU_COLLECTION=

TESTPAD_API_KEY=

TESTPAD_PROJECT_ID=

TESTPAD_PROJECT_NAME=

TESTPAD_SITE_URL=

TESTPAD_TEMPLATE_NAME=

TESTPAD_SCRIPT_URL=

SLACK_WEBHOOK_URL=

SLACK_BOT_TOKEN=

GURU_ACCESS_TOKEN=
