{
  "name": "af-automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "bddgen": "npx bddgen",
    "playwright": "npx playwright test",
    "playwright:bs": "npx browserstack-node-sdk playwright test",
    "test:multi-locale:regression": "npx bddgen && node scripts/run-playwright-grep.mjs --fixed=Regression --vars=TAG",
    "test:multi-locale:regression:batch": "npx bddgen && node scripts/run-playwright-grep.mjs --vars=BATCH,TAG",
    "test:multi-locale:regression:phone": "npx bddgen && node scripts/run-playwright-grep.mjs --fixed=Regression,PhoneNumber --vars=FEATURE,TAG",
    "test:multi-locale:smoke": "npx bddgen && node scripts/run-playwright-grep.mjs --fixed=Smoke --vars=TAG",
    "test:multi-locale:smoke:batch": "npx bddgen && node scripts/run-playwright-grep.mjs --fixed=Smoke --vars=BATCH,TAG",
    "test:multi-locale:all": "npx bddgen && node scripts/run-playwright-grep.mjs --vars=TAG",
    "test:multi-locale:all:batch": "npx bddgen && node scripts/run-playwright-grep.mjs --vars=BATCH,TAG",
    "test:multi-locale:feature": "npx bddgen && node scripts/run-playwright-grep.mjs --vars=FEATURE,TAG",
    "test:multi-locale:feature:bs": "npm run clean && npx bddgen && cross-env-shell NODE_ENV=$npm_config_env LOCALE=$npm_config_locale TAG=$npm_config_tag dotenv -e .env.$npm_config_env -- npx browserstack-node-sdk playwright test ./features/.*/staticPage.feature --grep @$TAG --config=playwright.browserstack.config.ts",
    "test:multi-locale:feature:bs:rs": "npm run clean && npx bddgen && cross-env-shell NODE_ENV=UAT LOCALE=EN-US TAG=$npm_config_tag dotenv -e .env.$npm_config_env -- npx browserstack-node-sdk playwright test ./features/.*/mainFlowsWithRudderstack.feature --grep @$TAG --config=playwright.browserstack.config.ts",
    "test:multi-locale:feature:bs:bat": "npm run clean && npx bddgen && cross-env-shell NODE_ENV=SIT LOCALE=EN-US TAG=$npm_config_tag dotenv -e .env.$npm_config_env -- npx browserstack-node-sdk playwright test ./features/.*/book-a-tour-standalone.feature --grep @$TAG --config=playwright.browserstack.config.ts",
    "test:oneTrust:local": "npx bddgen && cross-env-shell NODE_ENV=$npm_config_env REGION=$npm_config_region npx playwright test --grep @$REGION",
    "test:oneTrust:bs": "npx bddgen && cross-env-shell NODE_ENV=$npm_config_env REGION=$npm_config_region dotenv -e .env.$npm_config_env -- npx browserstack-node-sdk playwright test --grep @$REGION --config=playwright.browserstack.config.ts",
    "test:auto-search:bs": "npx bddgen && cross-env-shell NODE_ENV=SIT REGION=US dotenv -e .env.sit -- npx browserstack-node-sdk playwright test --grep @AUTO_SEARCH --config=playwright.browserstack.config.ts",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test --ui",
    "test:debug": "npx playwright test --debug",
    "clean": "rimraf allure-results/ && node scripts/clean-temp-logs.mjs",
    "clean:logs": "node scripts/clean-temp-logs.mjs",
    "allure:prepare-history": "ts-node scripts/prepare-allure-history.ts",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report --name \"Anytime-Fitness-Report\"",
    "allure:open": "allure open allure-report",
    "lint": "eslint . --ext .ts,.js,.mjs",
    "lint:fix": "eslint . --ext .ts,.js,.mjs --fix",
    "lint:check": "eslint . --ext .ts,.js,.mjs --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "steps:reorder": "eslint --fix \"step-definitions/**/*.steps.ts\"",
    "steps:reorder:dry-run": "eslint \"step-definitions/**/*.steps.ts\" --no-error-on-unmatched-pattern",
    "sync:knowledge-base": "node scripts/sync-knowledge-base.mjs",
    "sync:knowledge-base:fast": "node scripts/sync-knowledge-base.mjs --skip-links",
    "sync:knowledge-base:assemble-dump": "node scripts/assemble-mcp-sheet-dump.mjs",
    "verify:scenario-coverage": "node scripts/verify-scenario-coverage.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outliant/AF-Automation.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/outliant/AF-Automation/issues"
  },
  "homepage": "https://github.com/outliant/AF-Automation#readme",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.50.1",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.3.0",
    "browserstack-node-sdk": "^1.50.2",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-playwright": "^2.2.2",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "playwright": "^1.50.1",
    "playwright-bdd": "^8.3.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "yaml": "^2.8.0"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.26",
    "@faker-js/faker": "^9.9.0",
    "cld3-asm": "^4.0.0",
    "dotenv": "^17.2.0",
    "libphonenumber-js": "^1.12.15",
    "node-fetch": "^3.3.2",
    "winston": "^3.17.0"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "prettier --write --end-of-line auto",
      "eslint --fix --max-warnings 0 --rule 'playwright/no-wait-for-timeout: off'"
    ],
    "*.{json,md}": [
      "prettier --write --end-of-line auto"
    ]
  }
}
